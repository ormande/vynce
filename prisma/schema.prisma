// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
  SALE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT_CARD
  CREDIT_CARD
  CREDIT
}

enum SalePaymentStatus {
  PAID
  PARTIAL
  PENDING
  OVERDUE
}

enum ReceivableStatus {
  OPEN
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum TransferStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id              String            @id @default(cuid())
  name            String?
  email           String?           @unique
  emailVerified   DateTime?
  image           String?
  phone           String?
  status          UserStatus        @default(ACTIVE)
  lastLoginAt     DateTime?
  roleId          String?
  role            Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  accounts        Account[]
  sessions        Session[]
  sales           Sale[]
  inventoryMoves  InventoryMovement[]
  paymentsCreated Payment[]         @relation("PaymentCreatedBy")
  categories      Category[]
  userPermissions UserPermission[]
  userBranches    UserBranch[]
  cashSessions    CashRegisterSession[]
  transfersRequested StockTransfer[] @relation("StockTransferRequestedBy")
  transfersConfirmed StockTransfer[] @relation("StockTransferConfirmedBy")
  lastTransfersViewedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  roles       RolePermission[]
  users       UserPermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  allowed      Boolean    @default(true)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model PlatformSettings {
  id                     String   @id @default("default")
  allowSalesWithoutStock Boolean  @default(false)
  singleUnitMode         Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

model Branch {
  id              String                 @id @default(cuid())
  name            String
  address         String?
  isActive        Boolean                @default(true)
  isWarehouse     Boolean                @default(false)
  userBranches    UserBranch[]
  sales           Sale[]
  branchStocks    BranchStock[]
  inventoryMoves  InventoryMovement[]
  cashSessions    CashRegisterSession[]
  transfersOut    StockTransfer[]        @relation("StockTransferFrom")
  transfersIn     StockTransfer[]        @relation("StockTransferTo")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model UserBranch {
  id         String   @id @default(cuid())
  userId     String
  branchId   String
  accessAll  Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, branchId])
}

model BranchStock {
  id                String   @id @default(cuid())
  branchId          String
  productId         String
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
}

model CashRegisterSession {
  id              String        @id @default(cuid())
  branchId        String
  userId          String
  status          SessionStatus @default(OPEN)
  openedAt        DateTime      @default(now())
  closedAt        DateTime?
  openingBalance  Decimal       @default(0) @db.Decimal(10, 2)
  closingBalance  Decimal?      @db.Decimal(10, 2)
  notes           String?
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales           Sale[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  phone       String       @unique
  cpf         String?      @unique
  address     String?
  notes       String?
  isActive    Boolean      @default(true)
  sales       Sale[]
  receivables Receivable[]
  payments    Payment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                 String              @id @default(cuid())
  code               String?             @unique
  name               String
  description        String?
  costPrice          Decimal             @db.Decimal(10, 2)
  salePrice          Decimal             @db.Decimal(10, 2)
  minPrice           Decimal             @default(0) @db.Decimal(10, 2)
  stockQuantity      Int                 @default(0)
  lowStockThreshold  Int                 @default(5)
  status             ProductStatus       @default(ACTIVE)
  categoryId         String
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  saleItems          SaleItem[]
  inventoryMoves     InventoryMovement[]
  branchStocks       BranchStock[]
  stockTransfers     StockTransfer[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model StockTransfer {
  id              String         @id @default(cuid())
  fromBranchId    String
  toBranchId      String
  productId       String
  requestedById   String
  confirmedById   String?
  quantity        Int
  status          TransferStatus @default(PENDING)
  requestedAt     DateTime       @default(now())
  confirmedAt     DateTime?
  notes           String?
  fromBranch      Branch         @relation("StockTransferFrom", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch        Branch         @relation("StockTransferTo", fields: [toBranchId], references: [id], onDelete: Restrict)
  product         Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  requestedBy     User           @relation("StockTransferRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  confirmedBy     User?          @relation("StockTransferConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([toBranchId, status])
  @@index([fromBranchId])
  @@index([requestedById])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  productId     String
  performedById String?
  type          InventoryMovementType
  quantity      Int
  previousStock Int
  currentStock  Int
  note          String?
  branchId      String?
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch        Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  performedBy   User?                 @relation(fields: [performedById], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())
}

model Sale {
  id            String                 @id @default(cuid())
  branchId      String
  sessionId     String?
  customerId    String
  sellerId      String?
  paymentMethod PaymentMethod
  paymentStatus SalePaymentStatus      @default(PENDING)
  subtotal      Decimal                @db.Decimal(10, 2)
  discount      Decimal                @default(0) @db.Decimal(10, 2)
  total         Decimal                @db.Decimal(10, 2)
  soldAt        DateTime               @default(now())
  dueDate       DateTime?
  notes         String?
  branch        Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  session       CashRegisterSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  customer      Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  seller        User?                  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  items         SaleItem[]
  receivable    Receivable?
  payments      Payment[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

model SaleItem {
  id           String   @id @default(cuid())
  saleId       String
  productId    String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2)
  costSnapshot Decimal  @db.Decimal(10, 2)
  total        Decimal  @db.Decimal(10, 2)
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
}

model Receivable {
  id             String           @id @default(cuid())
  customerId     String
  saleId         String?          @unique
  status         ReceivableStatus @default(OPEN)
  originalAmount Decimal          @db.Decimal(10, 2)
  paidAmount     Decimal          @default(0) @db.Decimal(10, 2)
  balanceDue     Decimal          @db.Decimal(10, 2)
  dueDate        DateTime
  lastPaymentAt  DateTime?
  notes          String?
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale           Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  payments       Payment[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Payment {
  id            String        @id @default(cuid())
  customerId    String?
  saleId        String?
  receivableId  String?
  createdById   String?
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  receivedAt    DateTime      @default(now())
  note          String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale          Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  receivable    Receivable?   @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
