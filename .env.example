# --- Banco (Prisma lê sempre DATABASE_URL) ---

# Desenvolvimento local com Postgres na máquina:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vynce?schema=public"

# Seu PC / CI / ferramentas FORA da rede Railway (migrate, seed, Prisma Studio):
# Use a URL pública do painel (host tipo *.proxy.rlwy.net — no Railway costuma aparecer como DATABASE_PUBLIC_URL).
# DATABASE_URL="postgresql://postgres:SENHA@HOST_PUBLICO:PORTA/railway"

# Serviço Next.js DENTRO do Railway (mesmo projeto que o Postgres):
# Use a URL interna (host *.railway.internal:5432) — melhor latência e não expõe o DB na internet.
# No painel do Railway, referencie a variável DATABASE_URL do plugin Postgres para o serviço Web.
# DATABASE_URL="postgresql://postgres:SENHA@postgres.railway.internal:5432/railway"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-with-a-long-random-secret"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
